GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=talentverify
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Official "Verified on LinkedIn" OAuth application credentials.
# Register the redirect URL below exactly in the LinkedIn Developer Portal.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/oauth/callback
# development/lite: identity + workplace verification categories.
# plus: also requests current experience and most recent education.
LINKEDIN_VERIFIED_TIER=development
LINKEDIN_API_VERSION=202607
